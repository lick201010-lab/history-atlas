{
  "name": "history-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "compile:boundaries": "node scripts/boundaryCompiler/compileBoundaryAnchors.mjs",
    "validate:data": "node scripts/validateHistoricalData.mjs",
    "audit:boundary-quality": "node scripts/auditBoundaryQuality.mjs",
    "audit:f2-batch05": "node scripts/auditF2BoundaryBatch05Playwright.mjs",
    "audit:f2-batch06": "node scripts/auditF2BoundaryBatch06Playwright.mjs",
    "audit:f2-batch07": "node scripts/auditF2BoundaryBatch07Playwright.mjs",
    "audit:glb": "node scripts/auditGlbAssets.mjs",
    "audit:visual-foundation": "node scripts/visualFoundationAudit.mjs",
    "test:boundary-outlines": "node scripts/testBoundaryOutlines.mjs",
    "test:boundary-focus": "node scripts/testBoundaryFocus.mjs",
    "smoke:release": "node scripts/releaseSmoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run validate:data && npm run test:boundary-outlines && npm run test:boundary-focus && npm run audit:glb && npm run build",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "maplibre-gl": "^4.7.1",
    "three": "^0.160.0"
  },
  "devDependencies": {}
}
