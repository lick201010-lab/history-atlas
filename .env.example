# =============================================================================
# 历史沙盘 · 环境变量模板
# =============================================================================
# 用法：
#   1. 复制本文件为 .env.local（已在 .gitignore 里，不会被提交）
#   2. 按需修改下面的值
#   3. Vite 只暴露以 VITE_ 开头的变量给前端 import.meta.env
#
# 当前 MVP 阶段实际并未读取任何运行时环境变量。
# 这里列出的是"未来可能用到"的占位，提交模板仅用于约定。
# 不要把真实密钥写进本文件，也不要把 .env.local 提交到 Git。
# =============================================================================

# 应用名称（可被构建注入到 HTML title / OG meta）
VITE_APP_NAME=history-atlas

# 部署目标标识：本地 local / 阿里云 aliyun / 其他
VITE_DEPLOY_TARGET=aliyun

# 后续如果需要接入后端 API，反向代理统一前缀（示例）
# VITE_API_BASE_URL=/api

# 后续如果切换瓦片源，可以用环境变量覆盖
# VITE_BASEMAP_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png
# VITE_TERRAIN_URL=https://tiles.example.com/dem/{z}/{x}/{y}.png

# 仅在 .env.local 里写真实值，永远不要 commit 真实密钥
